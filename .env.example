# --- Postgres / PostGIS -----------------------------------------------
POSTGRES_USER=riding_app
POSTGRES_PASSWORD=riding_app_dev
POSTGRES_DB=riding_app
POSTGRES_PORT=5433
DATABASE_URL=postgresql://riding_app:riding_app_dev@localhost:5433/riding_app

# --- Hono API ------------------------------------------------------------
API_PORT=8787

# --- Routing engine (GraphHopper) ---------------------------------------
GRAPHHOPPER_URL=http://localhost:8989

# --- AI SDK ---------------------------------------------------------------
# Provider-agnostic (see apps/api/src/lib/ai/model.ts): set AI_PROVIDER to
# "anthropic", "openai", or "openrouter" and fill in the matching key. Model
# IDs default to a cheap/fast model suited to narrow extraction; override via
# ANTHROPIC_MODEL / OPENAI_MODEL / OPENROUTER_MODEL if needed. OpenRouter
# model slugs differ from the providers' own IDs — see openrouter.ai/models.
AI_PROVIDER=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

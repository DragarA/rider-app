# --- Postgres / PostGIS -----------------------------------------------
POSTGRES_USER=riding_app
POSTGRES_PASSWORD=riding_app_dev
POSTGRES_DB=riding_app
POSTGRES_PORT=5433
DATABASE_URL=postgresql://riding_app:riding_app_dev@localhost:5433/riding_app

# --- Hono API ------------------------------------------------------------
API_PORT=8787
WEB_ORIGIN=http://localhost:5173

# --- Auth (Better Auth) ---------------------------------------------------
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# --- Routing engine (GraphHopper) ---------------------------------------
GRAPHHOPPER_URL=http://localhost:8989

# --- Admin (Phase 5 POI moderation) ---------------------------------------
# Comma-separated emails allowed to moderate POIs (POST /pois/:id/verify)
# and see the pending-POI queue. No signup flow — just add an existing
# account's email here.
ADMIN_EMAILS=

# --- NAP (nap.si, Slovenia's National Access Point) — mountain-pass conditions
# Register at nap.si and request the "Roadworks (english GeoJSON)" and
# "Traffic events (english GeoJSON)" datasets, then fill these in from your
# NAP account. Feature degrades gracefully (GET /conditions/passes returns
# {configured: false}) when unset — see PROJECT_SPEC.md §0.1 for this
# integration's live-verification status.
NAP_USERNAME=
NAP_PASSWORD=
NAP_CLIENT_ID=
# NAP_CLIENT_SECRET=   # only if your NAP account's token endpoint needs it

# --- AI SDK ---------------------------------------------------------------
# Provider-agnostic (see apps/api/src/lib/ai/model.ts): set AI_PROVIDER to
# "anthropic", "openai", or "openrouter" and fill in the matching key. Model
# IDs default to a cheap/fast model suited to narrow extraction; override via
# ANTHROPIC_MODEL / OPENAI_MODEL / OPENROUTER_MODEL if needed. OpenRouter
# model slugs differ from the providers' own IDs — see openrouter.ai/models.
AI_PROVIDER=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

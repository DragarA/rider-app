{
  "name": "riding-app",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @riding-app/api dev",
    "dev:web": "pnpm --filter @riding-app/web dev",
    "db:generate": "pnpm --filter @riding-app/db generate",
    "db:migrate": "pnpm --filter @riding-app/db migrate",
    "db:seed": "pnpm --filter @riding-app/db seed",
    "db:seed:pois": "pnpm --filter @riding-app/db seed:pois",
    "db:studio": "pnpm --filter @riding-app/db studio",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
